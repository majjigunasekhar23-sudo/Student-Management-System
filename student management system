
#include <iostream>
#include <fstream>
#include <string>
using namespace std;

class Student {
public:
    int id, age;
    string name;
    float marks;
};

class StudentManagement {
private:
    Student s[100];
    int count = 0;

    void saveToFile() {
        ofstream file("students.txt");

        for (int i = 0; i < count; i++) {
            file << s[i].id << endl;
            file << s[i].name << endl;
            file << s[i].age << endl;
            file << s[i].marks << endl;
        }

        file.close();
    }

    void loadFromFile() {
        ifstream file("students.txt");

        count = 0;

        while (count < 100 && file >> s[count].id) {
            file.ignore();
            getline(file, s[count].name);
            file >> s[count].age;
            file >> s[count].marks;
            file.ignore();

            count++;
        }

        file.close();
    }

public:
    StudentManagement() {
        loadFromFile();
    }

    void addStudent() {
        if (count >= 100) {
            cout << "Student limit reached!\n";
            return;
        }

        Student st;

        cout << "Enter Student ID: ";
        cin >> st.id;

        for (int i = 0; i < count; i++) {
            if (s[i].id == st.id) {
                cout << "Student ID already exists!\n";
                return;
            }
        }

        cin.ignore();

        cout << "Enter Student Name: ";
        getline(cin, st.name);

        cout << "Enter Age: ";
        cin >> st.age;

        cout << "Enter Marks: ";
        cin >> st.marks;

        s[count++] = st;
        saveToFile();

        cout << "Student added successfully!\n";
    }

    void displayStudents() {
        if (count == 0) {
            cout << "No student records found!\n";
            return;
        }

        cout << "\n===== STUDENT DETAILS =====\n";

        for (int i = 0; i < count; i++) {
            cout << "\nID: " << s[i].id;
            cout << "\nName: " << s[i].name;
            cout << "\nAge: " << s[i].age;
            cout << "\nMarks: " << s[i].marks;
            cout << "\n-------------------------\n";
        }
    }

    void searchStudent() {
        int id;
        cout << "Enter Student ID to search: ";
        cin >> id;

        for (int i = 0; i < count; i++) {
            if (s[i].id == id) {
                cout << "\nStudent Found!\n";
                cout << "ID: " << s[i].id << endl;
                cout << "Name: " << s[i].name << endl;
                cout << "Age: " << s[i].age << endl;
                cout << "Marks: " << s[i].marks << endl;
                return;
            }
        }

        cout << "Student not found!\n";
    }

    void updateStudent() {
        int id;
        cout << "Enter Student ID to update: ";
        cin >> id;

        for (int i = 0; i < count; i++) {
            if (s[i].id == id) {
                cin.ignore();

                cout << "Enter New Name: ";
                getline(cin, s[i].name);

                cout << "Enter New Age: ";
                cin >> s[i].age;

                cout << "Enter New Marks: ";
                cin >> s[i].marks;

                saveToFile();

                cout << "Student updated successfully!\n";
                return;
            }
        }

        cout << "Student not found!\n";
    }

    void deleteStudent() {
        int id;
        cout << "Enter Student ID to delete: ";
        cin >> id;

        for (int i = 0; i < count; i++) {
            if (s[i].id == id) {
                for (int j = i; j < count - 1; j++) {
                    s[j] = s[j + 1];
                }

                count--;
                saveToFile();

                cout << "Student deleted successfully!\n";
                return;
            }
        }

        cout << "Student not found!\n";
    }
};

int main() {
    StudentManagement sm;
    int choice;

    do {
        cout << "\n===== STUDENT MANAGEMENT SYSTEM =====";
        cout << "\n1. Add Student";
        cout << "\n2. Display Students";
        cout << "\n3. Search Student";
        cout << "\n4. Update Student";
        cout << "\n5. Delete Student";
        cout << "\n6. Exit";

        cout << "\nEnter your choice: ";
        cin >> choice;

        switch (choice) {
        case 1:
            sm.addStudent();
            break;

        case 2:
            sm.displayStudents();
            break;

        case 3:
            sm.searchStudent();
            break;

        case 4:
            sm.updateStudent();
            break;

        case 5:
            sm.deleteStudent();
            break;

        case 6:
            cout << "Thank you for using Student Management System!\n";
            break;

        default:
            cout << "Invalid choice! Try again.\n";
        }

    } while (choice != 6);

    return 0;
}
